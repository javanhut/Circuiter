(
    description: "Multiplexer: y is one of d0 to d3, chosen by sel",
    prefix: "MUX",
    ports: [
        (name: "d0", kind: Input, width_of: "width"),
        (name: "d1", kind: Input, width_of: "width"),
        (name: "d2", kind: Input, width_of: "width"),
        (name: "d3", kind: Input, width_of: "width"),
        (name: "sel", kind: Input, description: "Select", width: 2),
        (name: "y", kind: Output, description: "Output", width_of: "width"),
    ],
    params: [(name: "width", kind: Integer, default: "32", description: "Bits")],
)

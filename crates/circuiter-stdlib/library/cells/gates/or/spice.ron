(
    template: "X${inst} ${node.a} ${node.b} ${node.y} ${node.vdd} ${node.gnd} ${model}",
    models: [
        ".subckt ${model} a b y vdd gnd\nMP1 n1 a vdd vdd phc W=96u L=1u AD=96p AS=96p PD=194u PS=194u\nMP2 z b n1 vdd phc W=96u L=1u AD=96p AS=96p PD=194u PS=194u\nMN1 z a gnd gnd nhc W=20u L=1u AD=20p AS=20p PD=42u PS=42u\nMN2 z b gnd gnd nhc W=20u L=1u AD=20p AS=20p PD=42u PS=42u\nMPY y z vdd vdd phc W=48u L=1u AD=48p AS=48p PD=98u PS=98u\nMNY y z gnd gnd nhc W=20u L=1u AD=20p AS=20p PD=42u PS=42u\n.model nhc NMOS(LEVEL=1 VTO=0.8 KP=60u LAMBDA=0.02 GAMMA=0.5 PHI=0.7 TOX=20n CGSO=0.4n CGDO=0.4n CJ=0.3m CJSW=0.3n MJ=0.5 MJSW=0.33 PB=0.8)\n.model phc PMOS(LEVEL=1 VTO=-0.8 KP=25u LAMBDA=0.03 GAMMA=0.5 PHI=0.7 TOX=20n CGSO=0.4n CGDO=0.4n CJ=0.3m CJSW=0.3n MJ=0.5 MJSW=0.33 PB=0.8)\n.ends",
    ],
)

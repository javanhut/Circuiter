(
    template: "R${inst}1 ${node.vcc} ${node.ctrl} 5k\nR${inst}2 ${node.ctrl} ${inst}_l 5k\nR${inst}3 ${inst}_l ${node.gnd} 5k\nB${inst}s ${inst}_s 0 V=0.5*(1+tanh(500*(V(${inst}_l)-V(${node.trig}))))\nB${inst}r ${inst}_r 0 V=0.5*(1+tanh(500*(V(${node.thr})-V(${node.ctrl}))))\nB${inst}x ${inst}_x 0 V=0.5*(1+tanh(20*(0.7+V(${node.gnd})-V(${node.rst}))))\nB${inst}a ${inst}_at 0 V=(1-max(0.5*(1+tanh(20*(V(${inst}_r)-0.5)))*(1-0.5*(1+tanh(20*(V(${inst}_s)-0.5)))),0.5*(1+tanh(20*(V(${inst}_x)-0.5)))))*(1-0.5*(1+tanh(20*(V(${inst}_b)-0.5))))\nR${inst}a ${inst}_at ${inst}_a 1k\nC${inst}a ${inst}_a 0 20p\nB${inst}b ${inst}_bt 0 V=(1-0.5*(1+tanh(20*(V(${inst}_s)-0.5)))*(1-0.5*(1+tanh(20*(V(${inst}_x)-0.5)))))*(1-0.5*(1+tanh(20*(V(${inst}_a)-0.5))))\nR${inst}b ${inst}_bt ${inst}_b 1k\nC${inst}b ${inst}_b 0 20p\nB${inst}h ${inst}_h 0 V=0.5*(1+tanh(20*(V(${inst}_a)-0.5)))\nB${inst}o ${inst}_o 0 V=V(${node.gnd})+0.1+V(${inst}_h)*(V(${node.vcc},${node.gnd})-1.8)\nV${inst}s ${inst}_o ${inst}_p DC 0\nR${inst}o ${inst}_p ${node.out} 10\nB${inst}i ${node.vcc} 0 I=uramp(I(V${inst}s))\nB${inst}k 0 ${node.gnd} I=uramp(-I(V${inst}s))\nB${inst}d ${node.dis} ${node.gnd} I=0.5*(1+tanh(20*(V(${inst}_b)-0.5)))*0.2*tanh(V(${node.dis},${node.gnd})/2)\nR${inst}q ${node.vcc} ${node.gnd} 1.6k\nR${inst}t ${node.rst} ${node.vcc} 1meg\nR${inst}g ${node.trig} ${node.gnd} 1g\nR${inst}h ${node.thr} ${node.gnd} 1g",
)

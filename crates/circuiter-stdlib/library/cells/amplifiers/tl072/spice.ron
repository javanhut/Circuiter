(
    template: "R${inst}i ${node.inp} ${node.inn} ${param.rin}\nB${inst}m ${inst}_m 0 V=(V(${node.vp})+V(${node.vn}))/2\nB${inst}g ${inst}_m ${inst}_x I=${param.sr}*1e-9*tanh(6.283185307*${param.gbw}*(V(${node.inp},${node.inn})+${param.vos})/${param.sr})\nR${inst}g ${inst}_x ${inst}_m {${param.gain}/(6.283185307*${param.gbw}*1e-9)}\nC${inst}g ${inst}_x ${inst}_m 1n\nB${inst}c ${inst}_x ${inst}_m I=uramp(V(${inst}_x,${inst}_m)-V(${node.vp},${node.vn}))-uramp(V(${inst}_m,${inst}_x)-V(${node.vp},${node.vn}))\nB${inst}o ${inst}_o 0 V=limit(V(${inst}_x,${inst}_m)+V(${inst}_m),V(${node.vn})+${param.vlow},V(${node.vp})-${param.vhigh})-300*(uramp(I(V${inst}s)-${param.isc})-uramp(-I(V${inst}s)-${param.isc}))\nV${inst}s ${inst}_o ${inst}_s DC 0\nR${inst}o ${inst}_s ${node.out} ${param.rout}\nB${inst}p ${node.vp} 0 I=uramp(I(V${inst}s))\nB${inst}n 0 ${node.vn} I=uramp(-I(V${inst}s))\nB${inst}q ${node.vp} ${node.vn} I=${param.iq}*tanh(V(${node.vp},${node.vn}))",
)

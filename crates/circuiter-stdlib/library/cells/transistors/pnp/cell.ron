(
    description: "PNP bipolar transistor (Gummel-Poon). Defaults are a 2N3906",
    prefix: "Q",
    ports: [
        (name: "c", description: "Collector"),
        (name: "b", kind: Input, description: "Base"),
        (name: "e", description: "Emitter"),
    ],
    params: [
        (name: "is", kind: Real(unit: "A"), default: "1.41f", description: "Saturation current"),
        (name: "bf", kind: Real(unit: ""), default: "180.7", description: "Forward current gain"),
        (name: "br", kind: Real(unit: ""), default: "4.977", description: "Reverse current gain"),
        (name: "vaf", kind: Real(unit: "V"), default: "18.7", description: "Forward Early voltage"),
        (
            name: "ikf",
            kind: Real(unit: "A"),
            default: "80m",
            description: "Forward gain roll-off current",
        ),
        (
            name: "ise",
            kind: Real(unit: "A"),
            default: "0",
            description: "Base-emitter leakage saturation current",
        ),
        (
            name: "ne",
            kind: Real(unit: ""),
            default: "1.5",
            description: "Base-emitter leakage emission coefficient",
        ),
        (name: "rb", kind: Real(unit: "Ω"), default: "10", description: "Base resistance"),
        (name: "rc", kind: Real(unit: "Ω"), default: "2.5", description: "Collector resistance"),
        (
            name: "cje",
            kind: Real(unit: "F"),
            default: "8.063p",
            description: "Base-emitter junction capacitance",
        ),
        (
            name: "mje",
            kind: Real(unit: ""),
            default: "0.3677",
            description: "Base-emitter grading coefficient",
        ),
        (
            name: "cjc",
            kind: Real(unit: "F"),
            default: "9.728p",
            description: "Base-collector junction capacitance",
        ),
        (
            name: "mjc",
            kind: Real(unit: ""),
            default: "0.5776",
            description: "Base-collector grading coefficient",
        ),
        (name: "tf", kind: Real(unit: "s"), default: "179.3p", description: "Forward transit time"),
        (
            name: "tr",
            kind: Real(unit: "s"),
            default: "33.42n",
            description: "Reverse transit time (sets storage time)",
        ),
        (
            name: "vceo",
            kind: Real(unit: "V"),
            default: "40",
            description: "Collector-emitter voltage rating",
        ),
    ],
    physics: (
        thermal_resistance: "200",
        heat_capacity: "2.5m",
        max_temperature: "200",
        limits: [Voltage(ports: ("c", "e"), max: "{1.5*${param.vceo}}")],
        failure: (mode: Short("c", "e"), effect: Pop),
    ),
)

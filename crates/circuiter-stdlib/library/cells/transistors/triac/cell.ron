(
    description: "Triac: a thyristor that conducts both ways, for AC loads (lamps, heaters, motors). A gate current of either sign, relative to mt1, turns it on until the current next passes through zero",
    prefix: "D",
    ports: [
        (name: "mt1", description: "Main terminal 1 (the gate\'s reference)"),
        (name: "mt2", description: "Main terminal 2"),
        (name: "g", kind: Input, description: "Gate"),
    ],
    params: [
        (
            name: "vdrm",
            kind: Real(unit: "V"),
            default: "600",
            description: "Off-state voltage rating",
        ),
    ],
    physics: (
        thermal_resistance: "60",
        heat_capacity: "1",
        max_temperature: "125",
        limits: [Voltage(ports: ("mt1", "mt2"), max: "{1.3*${param.vdrm}}")],
        failure: (mode: Short("mt1", "mt2"), effect: Pop),
    ),
)

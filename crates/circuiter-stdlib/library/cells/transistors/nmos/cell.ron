(
    description: "N-channel enhancement MOSFET (SPICE Level 1)",
    prefix: "M",
    ports: [
        (name: "d", description: "Drain"),
        (name: "g", kind: Input, description: "Gate"),
        (name: "s", description: "Source"),
        (name: "b", description: "Body (bulk)"),
    ],
    params: [
        (
            name: "package",
            kind: Choice(["to92", "sot23"]),
            default: "to92",
            description: "Package: through-hole or surface-mount, for the board",
        ),
        (name: "w", kind: Real(unit: "m"), default: "1u", description: "Channel width"),
        (name: "l", kind: Real(unit: "m"), default: "180n", description: "Channel length"),
        (
            name: "vto",
            kind: Real(unit: "V"),
            default: "0.7",
            description: "Zero-bias threshold voltage",
        ),
        (
            name: "kp",
            kind: Real(unit: "A/V²"),
            default: "110u",
            description: "Transconductance parameter",
        ),
        (
            name: "lambda",
            kind: Real(unit: "1/V"),
            default: "0.04",
            description: "Channel-length modulation",
        ),
        (
            name: "gamma",
            kind: Real(unit: "√V"),
            default: "0.4",
            description: "Body-effect coefficient",
        ),
        (name: "phi", kind: Real(unit: "V"), default: "0.65", description: "Surface potential"),
        (
            name: "tox",
            kind: Real(unit: "m"),
            default: "4.1n",
            description: "Gate oxide thickness; sets the intrinsic gate capacitance",
        ),
        (
            name: "cgso",
            kind: Real(unit: "F/m"),
            default: "300p",
            description: "Gate-source overlap capacitance per metre of width",
        ),
        (
            name: "cgdo",
            kind: Real(unit: "F/m"),
            default: "300p",
            description: "Gate-drain overlap capacitance per metre of width",
        ),
        (
            name: "cj",
            kind: Real(unit: "F/m²"),
            default: "1m",
            description: "Junction capacitance per area of drain and source diffusion",
        ),
        (
            name: "cjsw",
            kind: Real(unit: "F/m"),
            default: "250p",
            description: "Junction sidewall capacitance per metre of diffusion perimeter",
        ),
        (
            name: "vmax",
            kind: Real(unit: "V"),
            default: "3.6",
            description: "Gate oxide breakdown voltage",
        ),
    ],
    physics: (
        limits: [
            Voltage(ports: ("g", "s"), max: "${param.vmax}"),
            Voltage(ports: ("g", "d"), max: "${param.vmax}"),
        ],
        failure: (mode: Short("g", "s"), effect: Smoke),
    ),
)

(
    description: "NPN bipolar transistor (Gummel-Poon). Defaults are a 2N3904",
    prefix: "Q",
    ports: [
        (name: "c", description: "Collector"),
        (name: "b", kind: Input, description: "Base"),
        (name: "e", description: "Emitter"),
    ],
    params: [
        (name: "is", kind: Real(unit: "A"), default: "6.734f", description: "Saturation current"),
        (name: "bf", kind: Real(unit: ""), default: "416.4", description: "Forward current gain"),
        (name: "br", kind: Real(unit: ""), default: "0.7371", description: "Reverse current gain"),
        (
            name: "vaf",
            kind: Real(unit: "V"),
            default: "74.03",
            description: "Forward Early voltage",
        ),
        (
            name: "ikf",
            kind: Real(unit: "A"),
            default: "66.78m",
            description: "Forward gain roll-off current",
        ),
        (
            name: "ise",
            kind: Real(unit: "A"),
            default: "6.734f",
            description: "Base-emitter leakage saturation current",
        ),
        (
            name: "ne",
            kind: Real(unit: ""),
            default: "1.259",
            description: "Base-emitter leakage emission coefficient",
        ),
        (name: "rb", kind: Real(unit: "Ω"), default: "10", description: "Base resistance"),
        (name: "rc", kind: Real(unit: "Ω"), default: "1", description: "Collector resistance"),
        (
            name: "cje",
            kind: Real(unit: "F"),
            default: "4.493p",
            description: "Base-emitter junction capacitance",
        ),
        (
            name: "mje",
            kind: Real(unit: ""),
            default: "0.2593",
            description: "Base-emitter grading coefficient",
        ),
        (
            name: "cjc",
            kind: Real(unit: "F"),
            default: "3.638p",
            description: "Base-collector junction capacitance",
        ),
        (
            name: "mjc",
            kind: Real(unit: ""),
            default: "0.3085",
            description: "Base-collector grading coefficient",
        ),
        (name: "tf", kind: Real(unit: "s"), default: "301.2p", description: "Forward transit time"),
        (
            name: "tr",
            kind: Real(unit: "s"),
            default: "239.5n",
            description: "Reverse transit time (sets storage time)",
        ),
        (
            name: "vceo",
            kind: Real(unit: "V"),
            default: "40",
            description: "Collector-emitter voltage rating",
        ),
    ],
    physics: (
        thermal_resistance: "200",
        heat_capacity: "2.5m",
        max_temperature: "200",
        limits: [Voltage(ports: ("c", "e"), max: "{1.5*${param.vceo}}")],
        failure: (mode: Short("c", "e"), effect: Pop),
    ),
)

(
    graphics: [
        Circle(center: (-2.032, 0.0), radius: 0.508),
        Circle(center: (2.032, 0.0), radius: 0.508),
        Text(at: (0.0, -3.302), text: "${name}", anchor: Center),
    ],
    pins: [
        (port: "a", at: (-5.08, 0.0), direction: Right),
        (port: "b", at: (5.08, 0.0), direction: Left),
    ],
    states: [
        (
            when: "pressed=false",
            graphics: [
                Polyline(points: [(-2.54, -1.778), (2.54, -1.778)]),
                Polyline(points: [(0.0, -1.778), (0.0, -3.048)]),
            ],
        ),
        (
            when: "pressed=true",
            graphics: [
                Polyline(points: [(-2.54, -0.762), (2.54, -0.762)]),
                Polyline(points: [(0.0, -0.762), (0.0, -2.032)]),
            ],
        ),
    ],
)

(
    description: "Junction diode. Defaults approximate a 1N4148 small-signal diode",
    prefix: "D",
    ports: [(name: "a", description: "Anode"), (name: "k", description: "Cathode")],
    params: [
        (
            name: "package",
            kind: Choice(["axial", "sod123"]),
            default: "axial",
            description: "Package: through-hole or surface-mount, for the board",
        ),
        (name: "is", kind: Real(unit: "A"), default: "2.52n", description: "Saturation current"),
        (name: "n", kind: Real(unit: ""), default: "1.752", description: "Emission coefficient"),
        (name: "rs", kind: Real(unit: "Ω"), default: "0.568", description: "Series resistance"),
        (
            name: "bv",
            kind: Real(unit: "V"),
            default: "100",
            description: "Reverse breakdown voltage",
        ),
        (
            name: "cjo",
            kind: Real(unit: "F"),
            default: "4p",
            description: "Zero-bias junction capacitance",
        ),
        (name: "tt", kind: Real(unit: "s"), default: "20n", description: "Transit time"),
    ],
    physics: (
        thermal_resistance: "350",
        heat_capacity: "140u",
        max_temperature: "200",
        failure: (mode: Short("a", "k"), effect: Smoke),
    ),
)

(
    description: "Light-emitting diode. Its colour sets its forward voltage at 20 mA: about 2 V for red, orange, yellow and green, 3.1 V for blue and white. It glows on the sheet as current flows",
    prefix: "D",
    ports: [(name: "a", description: "Anode"), (name: "k", description: "Cathode")],
    params: [
        (
            name: "color",
            kind: Choice(["red", "orange", "yellow", "green", "blue", "white"]),
            default: "red",
            description: "Its colour",
        ),
        (name: "n", kind: Real(unit: ""), default: "2", description: "Emission coefficient"),
        (name: "rs", kind: Real(unit: "Ω"), default: "2", description: "Series resistance"),
        (name: "bv", kind: Real(unit: "V"), default: "5", description: "Reverse breakdown voltage"),
        (
            name: "cjo",
            kind: Real(unit: "F"),
            default: "20p",
            description: "Zero-bias junction capacitance",
        ),
        (
            name: "Imax",
            kind: Real(unit: "A"),
            default: "30m",
            description: "Maximum continuous current",
        ),
    ],
    physics: (
        thermal_resistance: "400",
        heat_capacity: "25u",
        max_temperature: "150",
        limits: [Current(port: "a", max: "{5*${param.Imax}}")],
        failure: (mode: Open, effect: Flash),
    ),
)

(
    description: "Zener diode: conducts forward like any diode and, in reverse, holds about vz across it. Defaults are a 1N4733A (5.1 V, 1 W)",
    prefix: "D",
    ports: [(name: "a", description: "Anode"), (name: "k", description: "Cathode")],
    params: [
        (
            name: "package",
            kind: Choice(["axial", "sod123"]),
            default: "axial",
            description: "Package: through-hole or surface-mount, for the board",
        ),
        (
            name: "vz",
            kind: Real(unit: "V"),
            default: "5.1",
            description: "Zener voltage at the test current",
        ),
        (name: "izt", kind: Real(unit: "A"), default: "49m", description: "Test current for vz"),
        (name: "rs", kind: Real(unit: "Ω"), default: "1", description: "Series resistance"),
        (name: "p", kind: Real(unit: "W"), default: "1", description: "Power rating"),
    ],
    physics: (
        thermal_resistance: "{100/${param.p}}",
        heat_capacity: "50m",
        max_temperature: "200",
        failure: (mode: Short("a", "k"), effect: Smoke),
    ),
)

(
    description: "Schottky diode: a low forward drop (about 0.4 V at 1 A) and no reverse recovery, for power supplies and protection. Defaults are a 1N5819 (40 V, 1 A)",
    prefix: "D",
    ports: [(name: "a", description: "Anode"), (name: "k", description: "Cathode")],
    params: [
        (name: "is", kind: Real(unit: "A"), default: "31.7u", description: "Saturation current"),
        (name: "n", kind: Real(unit: ""), default: "1.373", description: "Emission coefficient"),
        (name: "rs", kind: Real(unit: "Ω"), default: "51m", description: "Series resistance"),
        (
            name: "bv",
            kind: Real(unit: "V"),
            default: "40",
            description: "Reverse breakdown voltage",
        ),
        (
            name: "cjo",
            kind: Real(unit: "F"),
            default: "110p",
            description: "Zero-bias junction capacitance",
        ),
    ],
    physics: (
        thermal_resistance: "80",
        heat_capacity: "50m",
        max_temperature: "150",
        failure: (mode: Short("a", "k"), effect: Smoke),
    ),
)

(
    description: "D flip-flop: q takes d at each rising clock edge",
    prefix: "FF",
    ports: [
        (name: "d", kind: Input, description: "Data", width_of: "width"),
        (name: "clk", kind: Input, description: "Clock"),
        (name: "q", kind: Output, description: "Output", width_of: "width"),
    ],
    params: [(name: "width", kind: Integer, default: "1", description: "Bits")],
)

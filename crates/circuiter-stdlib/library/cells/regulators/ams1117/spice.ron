(
    template: "B${inst}r ${inst}_t 0 V=V(${node.gnd})+0.5*((0.5*((${param.vout})+(V(${node.in},${node.gnd})-${param.dropout})-sqrt(((${param.vout})-(V(${node.in},${node.gnd})-${param.dropout}))^2+1e-4)))+sqrt((0.5*((${param.vout})+(V(${node.in},${node.gnd})-${param.dropout})-sqrt(((${param.vout})-(V(${node.in},${node.gnd})-${param.dropout}))^2+1e-4)))^2+1e-6))-300*uramp(I(V${inst}s)-${param.ilimit})\nV${inst}s ${inst}_t ${inst}_u DC 0\nR${inst}o ${inst}_u ${node.out} 10m\nB${inst}i ${node.in} 0 I=uramp(I(V${inst}s))\nB${inst}k 0 ${node.gnd} I=uramp(-I(V${inst}s))\nB${inst}q ${node.in} ${node.gnd} I=${param.iq}*tanh(V(${node.in},${node.gnd})/0.5)",
